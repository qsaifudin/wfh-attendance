# Copy this file to .env.local for local development.

# Backend origin used by next.config.ts's rewrite proxy (server-side only).
BACKEND_ORIGIN="http://localhost:3001"

# Same origin, but exposed to the browser bundle — the Socket.IO client
# connects here directly (WebSocket upgrades don't go through the rewrite).
NEXT_PUBLIC_BACKEND_ORIGIN="http://localhost:3001"

# Must match the backend's JWT_SECRET — middleware.ts verifies the session
# cookie at the edge for route protection.
JWT_SECRET="change-me-to-a-long-random-string"
COOKIE_NAME="wfh_token"

# Shows the "Demo accounts" panel on the login page. Turn off for a
# production-style deployment.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
