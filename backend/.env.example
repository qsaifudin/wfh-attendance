# Copy this file to .env and fill in real values for local development.

# MySQL connection string used by Prisma.
DATABASE_URL="mysql://root:@127.0.0.1:3306/wfh_attendance"

# Server
PORT=3001
NODE_ENV=development

# Comma-separated list of origins allowed to call the API directly
# (the Next.js app itself talks to the API through a same-origin rewrite,
# so this is mainly needed for Swagger's "Try it out" and local tooling).
CORS_ORIGINS="http://localhost:3000"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
JWT_ISSUER="wfh-attendance"
COOKIE_NAME="wfh_token"
COOKIE_SECURE=false

# Attendance rules
ATTENDANCE_TIMEZONE="Asia/Jakarta"
ATTENDANCE_DEFAULT_LATE_TOLERANCE="09:30"
ATTENDANCE_DEFAULT_REQUIRE_LOCATION=true

# External file storage helper (already deployed, not part of this repo)
STORAGE_HELPER_BASE_URL="https://helper-service.qsaifudin.com"
STORAGE_HELPER_TIMEOUT_MS=15000

# Seed
SEED_DEMO_PASSWORD="attendance123"
